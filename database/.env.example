# Database credentials - Copy this file to .env and adjust if needed
# Default values match docker-compose.yml safe defaults (no .env required for local dev)
# DO NOT commit the .env file to version control

# PostgreSQL
POSTGRES_USER=devonz_user
POSTGRES_PASSWORD=devonz_local_pass
POSTGRES_DB=devonz_db
POSTGRES_PORT=5432

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=devonz_admin
MINIO_ROOT_PASSWORD=devonz_minio_pass
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PASSWORD=devonz_redis_pass
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# Neo4j
NEO4J_PASSWORD=devonz_neo4j_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
